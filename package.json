{
  "name": "cotizadora-fenix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verificar": "esbuild scripts/verificar-calculo.ts --bundle --loader:.png=dataurl --platform=node --format=esm --outfile=node_modules/.cache/verificar.mjs --log-level=error && node node_modules/.cache/verificar.mjs",
    "verificar:pdf": "esbuild scripts/verificar-pdf.ts --bundle --loader:.png=dataurl --platform=node --format=esm --outfile=node_modules/.cache/verificar-pdf.mjs --log-level=error && node node_modules/.cache/verificar-pdf.mjs",
    "typecheck": "tsc -b",
    "iconos": "powershell -ExecutionPolicy Bypass -File scripts/logo-a-iconos.ps1"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
